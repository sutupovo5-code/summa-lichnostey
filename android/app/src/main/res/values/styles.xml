<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тёмный фон с первого кадра: без белой вспышки при запуске -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="bg">#FF1A0E30</color>
    <color name="bar">#FF120A26</color>
    <color name="accent">#FFEC6F9B</color>
    <color name="ic_bg">#FF2A1446</color>
</resources>
