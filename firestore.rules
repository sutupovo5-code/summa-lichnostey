rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Общая лента сайта «Сумма Личностей»: читать могут все,
    // писать — только посетители с гостевым входом (Anonymous).
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['post', 'createdAt', 'ownerUid', 'likesAdd', 'cm', 'pv', 'top', 'del'])
        && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesAdd', 'cm', 'pv', 'top', 'del', 'post'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['post'])
            || resource.data.ownerUid == request.auth.uid);
      allow delete: if false;
    }
  }
}
