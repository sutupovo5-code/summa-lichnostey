rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Общая лента сайта «Сумма Личностей»: читать могут все,
    // писать — только посетители с гостевым входом (Anonymous).
    // Менять текст и удалять пост может только его автор.
    // top — время (мс), когда пост сделали «новостью дня»; сайт сам гасит её в полночь по Москве.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['post', 'createdAt', 'ownerUid', 'likesAdd', 'cm', 'pv', 'top', 'del'])
        && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid)
        && (!('del' in request.resource.data) || request.resource.data.del == false);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesAdd', 'cm', 'pv', 'top', 'del', 'post'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['post', 'del'])
            || resource.data.ownerUid == request.auth.uid);
      allow delete: if false;
    }
    // Видео к постам: файл режется на куски до ~0,9 МБ (не больше 12 кусков).
    // Кусок можно только создать; менять и удалять нельзя.
    match /media/{mediaId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['d', 'i', 'n', 'owner', 'type'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.d is bytes && request.resource.data.d.size() <= 950000
        && request.resource.data.i is int && request.resource.data.n is int
        && request.resource.data.i >= 0 && request.resource.data.i < request.resource.data.n
        && request.resource.data.n <= 12
        && request.resource.data.type in ['video/mp4', 'video/webm', 'video/quicktime'];
      allow update, delete: if false;
    }
    // Фото участников в «О нас» для всех. Первый, кто загрузил фото участника, становится его хозяином —
    // заменить фото может только он; удалять нельзя.
    match /team/{memberId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['img', 'owner', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() < 1000000
        && request.resource.data.img.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['img', 'owner', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() < 1000000
        && request.resource.data.img.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow delete: if false;
    }
    // Аккаунт по номеру и паролю: профиль, Σ, покупки, карточки. Читать и менять может только сам владелец.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['profile', 'st', 'shop', 'cards', 'eggs', 'v', 'updatedAt']);
      allow delete: if false;
    }
    // Сброс пароля (pack40): пароль, зашифрованный кодом восстановления. Без кода прочитать нельзя.
    // Открыть можно один документ по номеру (get), перечислять все — нельзя (list).
    // Записывать может только владелец аккаунта этого номера (логин = номер@summa-lich.app).
    match /recover/{phone} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.email == phone + '@summa-lich.app'
        && request.resource.data.keys().hasOnly(['salt', 'iv', 'ct', 'at', 'v'])
        && request.resource.data.ct is string && request.resource.data.ct.size() < 400
        && request.resource.data.salt is string && request.resource.data.iv is string;
      allow delete: if false;
    }
    // Рейтинг джекпотов и профили: каждый пишет только свою строку.
    // look — купленный в магазине вид профиля (рамка, значок, цвет имени, карточка).
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'photo', 'jackpots', 'spins', 'updatedAt', 'look', 'coll'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.jackpots is number && request.resource.data.jackpots >= 0
        && request.resource.data.spins is number && request.resource.data.spins >= 0
        && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 30000))
        && (!('look' in request.resource.data) || (request.resource.data.look is map && request.resource.data.look.size() <= 4))
        && (!('coll' in request.resource.data) || (request.resource.data.coll is map && request.resource.data.coll.size() <= 4));
    }
    // Особая карта X: один раз навсегда — первому, кто собрал все 130 карт.
    match /meta/firstX {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update, delete: if false;
    }
  }
}
