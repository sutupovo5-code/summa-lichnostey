rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Общая лента сайта «Сумма Личностей»: читать могут все,
    // писать — только посетители с гостевым входом (Anonymous).
    // Менять текст и удалять пост может только его автор.
    // top — время (мс), когда пост сделали «новостью дня»; сайт сам гасит её в полночь по Москве.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['post', 'createdAt', 'ownerUid', 'likesAdd', 'cm', 'pv', 'top', 'del'])
        && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid)
        && (!('del' in request.resource.data) || request.resource.data.del == false);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesAdd', 'cm', 'pv', 'top', 'del', 'post'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['post', 'del'])
            || resource.data.ownerUid == request.auth.uid);
      allow delete: if false;
    }
    // Видео к постам: файл режется на куски до ~0,9 МБ (не больше 12 кусков).
    // Кусок можно только создать; менять и удалять нельзя.
    match /media/{mediaId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['d', 'i', 'n', 'owner', 'type'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.d is bytes && request.resource.data.d.size() <= 950000
        && request.resource.data.i is int && request.resource.data.n is int
        && request.resource.data.i >= 0 && request.resource.data.i < request.resource.data.n
        && request.resource.data.n <= 12
        && request.resource.data.type in ['video/mp4', 'video/webm', 'video/quicktime'];
      allow update, delete: if false;
    }
    // Фото участников в «О нас» для всех. Первый, кто загрузил фото участника, становится его хозяином —
    // заменить фото может только он; удалять нельзя.
    match /team/{memberId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['img', 'owner', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() < 1000000
        && request.resource.data.img.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['img', 'owner', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() < 1000000
        && request.resource.data.img.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow delete: if false;
    }
    // Аккаунт по номеру и паролю: профиль, Σ, покупки, карточки. Читать и менять может только сам владелец.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['profile', 'st', 'shop', 'cards', 'eggs', 'v', 'updatedAt', 'assetOp']);
      allow delete: if false;
    }
    // Сброс пароля (pack40): пароль, зашифрованный кодом восстановления. Без кода прочитать нельзя.
    // Открыть можно один документ по номеру (get), перечислять все — нельзя (list).
    // Записывать может только владелец аккаунта этого номера (логин = номер@summa-lich.app).
    match /recover/{phone} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.email == phone + '@summa-lich.app'
        && request.resource.data.keys().hasOnly(['salt', 'iv', 'ct', 'at', 'v'])
        && request.resource.data.ct is string && request.resource.data.ct.size() < 400
        && request.resource.data.salt is string && request.resource.data.iv is string;
      allow delete: if false;
    }
    // Ивент «Ночной клуб» (pack43): очки игрока по каждой игре. Писать — только свою строку и только до финиша
    // (22.11.2026 00:00 мск = 1795294800000 мс). После финиша рейтинг заморожен — победителей видят все одинаково.
    match /evscore/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.time < timestamp.value(1795294800000)
        && request.resource.data.keys().hasOnly(['name', 'upd', 'ck', 'bj', 'rk', 'dk'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
    }
    // Онлайн-дурак (pack43): стол dkr/{КОД}. Создаёт хозяин; сесть может любой, пока место свободно;
    // дальше менять стол могут только двое игроков.
    match /dkr/{code} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.h.uid == request.auth.uid
        && request.resource.data.st == 'wait' && request.resource.data.g == null
        && request.resource.data.stake is int && request.resource.data.stake > 0;
      allow update: if request.auth != null && (
        resource.data.h.uid == request.auth.uid
        || (resource.data.g != null && resource.data.g.uid == request.auth.uid)
        || (resource.data.st == 'wait' && resource.data.g == null && request.resource.data.g.uid == request.auth.uid));
      allow delete: if false;
    }
    // Рейтинг джекпотов и профили: каждый пишет только свою строку.
    // look — купленный в магазине вид профиля (рамка, значок, цвет имени, карточка).
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'photo', 'jackpots', 'spins', 'updatedAt', 'look', 'coll'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.jackpots is number && request.resource.data.jackpots >= 0
        && request.resource.data.spins is number && request.resource.data.spins >= 0
        && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 30000))
        && (!('look' in request.resource.data) || (request.resource.data.look is map && request.resource.data.look.size() <= 4))
        && (!('coll' in request.resource.data) || (request.resource.data.coll is map && request.resource.data.coll.size() <= 4));
    }
    // Exchanges use escrow: creation reserves assets, acceptance pays the recipient,
    // cancellation refunds the sender, and claim pays the requested assets once.
    function signedPlayer() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function userBefore() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function userAfter() { return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function cardKey(c) { return c.replace('^(ch|sk):', ''); }
    function cardMapChange(kind, outCard, inCard, before, after) {
      let o = outCard.matches('^' + kind + ':.*') ? cardKey(outCard) : '';
      let i = inCard.matches('^' + kind + ':.*') ? cardKey(inCard) : '';
      let old = before.cards[kind];
      let next = after.cards[kind];
      let od = (o != '' ? -1 : 0) + (i == o && i != '' ? 1 : 0);
      let id = (i != '' ? 1 : 0) - (i == o && o != '' ? 1 : 0);
      return next.diff(old).affectedKeys().hasOnly([o,i])
        && next.get(o,0) == old.get(o,0) + od && next.get(o,0) >= 0
        && next.get(i,0) == old.get(i,0) + id && next.get(i,0) >= 0;
    }
    function assetChange(money, outCard, inCard, operation) {
      let before = userBefore();
      let after = userAfter();
      return after.assetOp == operation && before.get('assetOp','') != operation
        && after.st.sp == before.st.sp + money && after.st.sp >= 0
        && after.st.diff(before.st).affectedKeys().hasOnly(['sp'])
        && after.diff(before).affectedKeys().hasOnly(['st','cards','updatedAt','assetOp'])
        && after.cards.diff(before.cards).affectedKeys().hasOnly(['ch','sk'])
        && cardMapChange('ch', outCard, inCard, before, after) && cardMapChange('sk', outCard, inCard, before, after);
    }
    function validMoney(n) { return n is int && n >= 0 && n <= 1000000000; }
    function validCard(c) { return c is string && (c == '' || c.matches('^(ch|sk):[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?$')); }
    match /exchanges/{exchangeId} {
      allow read: if signedPlayer() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedPlayer()
        && request.resource.data.keys().hasOnly(['from','to','giveMoney','giveCard','wantMoney','wantCard','status','claimed','at'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() <= 128
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && validMoney(request.resource.data.giveMoney) && validMoney(request.resource.data.wantMoney)
        && validCard(request.resource.data.giveCard) && validCard(request.resource.data.wantCard)
        && (request.resource.data.giveMoney > 0 || request.resource.data.giveCard != '')
        && request.resource.data.status == 'pending' && request.resource.data.claimed == false
        && request.resource.data.at is int
        && assetChange(-request.resource.data.giveMoney, request.resource.data.giveCard, '', 'exchanges/' + exchangeId + ':create');
      allow update: if signedPlayer() && (
        (resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && (
          (resource.data.to == request.auth.uid && request.resource.data.status == 'accepted'
            && assetChange(resource.data.giveMoney-resource.data.wantMoney, resource.data.wantCard, resource.data.giveCard, 'exchanges/' + exchangeId + ':accept'))
          || (resource.data.from == request.auth.uid && request.resource.data.status == 'cancelled'
            && assetChange(resource.data.giveMoney, '', resource.data.giveCard, 'exchanges/' + exchangeId + ':cancel'))))
        || (resource.data.from == request.auth.uid && resource.data.status == 'accepted' && resource.data.claimed == false
          && request.resource.data.claimed == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
          && assetChange(resource.data.wantMoney, '', resource.data.wantCard, 'exchanges/' + exchangeId + ':claim')));
      allow delete: if false;
    }
    match /fundraisers/{postId} {
      function post() { return get(/databases/$(database)/documents/posts/$(postId)).data; }
      function contributionRecorded() {
        let path = /databases/$(database)/documents/fundraisers/$(postId)/contributors/$(request.auth.uid);
        let previous = exists(path) ? get(path).data.total : 0;
        let next = getAfter(path).data;
        return next.total == previous + request.resource.data.lastAmount && next.nonce == request.resource.data.nonce;
      }
      function validFund() {
        return request.resource.data.keys().hasOnly(['owner','goal','raised','paid','lastBy','lastAmount','nonce','leaderTotal','leaderUid','closed','closedAt'])
          && request.resource.data.owner == post().ownerUid && request.resource.data.goal == post().post.fundGoal
          && request.resource.data.nonce is string && request.resource.data.nonce.size() <= 64
          && validMoney(request.resource.data.goal) && request.resource.data.goal > 0
          && validMoney(request.resource.data.raised) && validMoney(request.resource.data.paid)
          && request.resource.data.paid <= request.resource.data.raised
          && request.resource.data.raised <= request.resource.data.goal;
      }
      allow read: if true;
      function validLeader() {
        let n = request.resource.data.leaderTotal;
        return validMoney(n) && n >= resource.data.get('leaderTotal',0)
          && (n == 0 ? request.resource.data.leaderUid == '' : get(/databases/$(database)/documents/fundraisers/$(postId)/contributors/$(request.resource.data.leaderUid)).data.total == n);
      }
      function donationLeader() {
        let old = resource == null ? 0 : resource.data.get('leaderTotal',0);
        let next = getAfter(/databases/$(database)/documents/fundraisers/$(postId)/contributors/$(request.auth.uid)).data.total;
        return request.resource.data.leaderTotal == (next > old ? next : old);
      }
      allow create: if signedPlayer() && validFund() && (
        (post().del != true && request.auth.uid != request.resource.data.owner && request.resource.data.paid == 0
          && request.resource.data.get('closed',false) == false
          && request.resource.data.lastBy == request.auth.uid
          && request.resource.data.lastAmount == request.resource.data.raised && request.resource.data.raised > 0
          && request.resource.data.leaderTotal == request.resource.data.raised
          && contributionRecorded()
          && assetChange(-request.resource.data.raised, '', '', 'fundraisers/' + postId + ':' + request.resource.data.nonce))
        || (request.auth.uid == request.resource.data.owner && request.resource.data.raised == 0 && request.resource.data.paid == 0
          && request.resource.data.lastBy == request.auth.uid && request.resource.data.lastAmount == 0
          && request.resource.data.get('closed',false) == true && request.resource.data.closedAt == request.time
          && request.resource.data.leaderTotal == 0 && request.resource.data.leaderUid == ''));
      allow update: if signedPlayer() && validFund()
        && request.resource.data.owner == resource.data.owner && request.resource.data.goal == resource.data.goal && (
          (request.auth.uid == resource.data.owner && resource.data.get('closed',false) == false
            && request.resource.data.get('closed',false) == true && request.resource.data.closedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed','closedAt','leaderTotal','leaderUid'])
            && validLeader())
          || (request.resource.data.lastBy == request.auth.uid && (
            (request.auth.uid != resource.data.owner && post().del != true && resource.data.get('closed',false) == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['raised','lastBy','lastAmount','nonce','leaderTotal'])
              && request.resource.data.paid == resource.data.paid && request.resource.data.lastAmount > 0
              && request.resource.data.raised == resource.data.raised + request.resource.data.lastAmount
              && contributionRecorded() && donationLeader()
              && assetChange(-request.resource.data.lastAmount, '', '', 'fundraisers/' + postId + ':' + request.resource.data.nonce))
            || (request.auth.uid == resource.data.owner && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid','lastBy','lastAmount','nonce'])
              && request.resource.data.raised == resource.data.raised && request.resource.data.paid == resource.data.raised
              && resource.data.raised > resource.data.paid && request.resource.data.lastAmount == 0
              && assetChange(resource.data.raised-resource.data.paid, '', '', 'fundraisers/' + postId + ':' + request.resource.data.nonce)))));
      allow delete: if false;
      match /contributors/{uid} {
        function validContribution() {
          let path = /databases/$(database)/documents/fundraisers/$(postId);
          let fund = getAfter(path).data;
          let previous = exists(path) ? get(path).data.get('nonce','') : '';
          return signedPlayer() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['name','total','nonce','at'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 60
            && request.resource.data.name == userAfter().profile.name
            && validMoney(request.resource.data.total) && request.resource.data.total > 0
            && request.resource.data.at is int && fund.lastBy == uid && fund.lastAmount > 0
            && request.resource.data.nonce == fund.nonce && previous != fund.nonce;
        }
        allow read: if true;
        allow create: if validContribution() && request.resource.data.total == getAfter(/databases/$(database)/documents/fundraisers/$(postId)).data.lastAmount;
        allow update: if validContribution() && request.resource.data.total == resource.data.total + getAfter(/databases/$(database)/documents/fundraisers/$(postId)).data.lastAmount;
        allow delete: if false;
      }
    }

    match /richTitles/{uid}/funds/{postId} {
      allow read: if true;
      allow create: if signedPlayer()
        && request.resource.data.keys().hasOnly(['title','amount','at'])
        && request.resource.data.title == 'Богач' && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/fundraisers/$(postId)).data.get('closed',false) == true
        && request.resource.data.amount > 0
        && request.resource.data.amount == get(/databases/$(database)/documents/fundraisers/$(postId)).data.leaderTotal
        && request.resource.data.amount == get(/databases/$(database)/documents/fundraisers/$(postId)/contributors/$(uid)).data.total;
      allow update, delete: if false;
    }

    // Особая карта X: один раз навсегда — первому, кто собрал все 130 карт.
    match /meta/firstX {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update, delete: if false;
    }
  }
}
