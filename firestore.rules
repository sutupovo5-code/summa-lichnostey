rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Общая лента сайта «Сумма Личностей»: читать могут все,
    // писать — только посетители с гостевым входом (Anonymous).
    // Менять текст и удалять пост может только его автор.
    // top — время (мс), когда пост сделали «новостью дня»; сайт сам гасит её в полночь по Москве.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['post', 'createdAt', 'ownerUid', 'likesAdd', 'cm', 'pv', 'top', 'del'])
        && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid)
        && (!('del' in request.resource.data) || request.resource.data.del == false);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesAdd', 'cm', 'pv', 'top', 'del', 'post'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['post', 'del'])
            || resource.data.ownerUid == request.auth.uid);
      allow delete: if false;
    }
    // Видео к постам: файл режется на куски до ~0,9 МБ (не больше 12 кусков).
    // Кусок можно только создать; менять и удалять нельзя.
    match /media/{mediaId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['d', 'i', 'n', 'owner', 'type'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.d is bytes && request.resource.data.d.size() <= 950000
        && request.resource.data.i is int && request.resource.data.n is int
        && request.resource.data.i >= 0 && request.resource.data.i < request.resource.data.n
        && request.resource.data.n <= 12
        && request.resource.data.type in ['video/mp4', 'video/webm', 'video/quicktime'];
      allow update, delete: if false;
    }
    // Рейтинг джекпотов и профили: каждый пишет только свою строку.
    // look — купленный в магазине вид профиля (рамка, значок, цвет имени, карточка).
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'photo', 'jackpots', 'spins', 'updatedAt', 'look'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.jackpots is number && request.resource.data.jackpots >= 0
        && request.resource.data.spins is number && request.resource.data.spins >= 0
        && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 30000))
        && (!('look' in request.resource.data) || (request.resource.data.look is map && request.resource.data.look.size() <= 4));
    }
  }
}
