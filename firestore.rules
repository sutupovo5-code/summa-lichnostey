rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Общая лента сайта «Сумма Личностей»: читать могут все,
    // писать — только посетители с гостевым входом (Anonymous).
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['post', 'createdAt', 'ownerUid', 'likesAdd', 'cm', 'pv', 'top', 'del'])
        && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesAdd', 'cm', 'pv', 'top', 'del', 'post'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['post'])
            || resource.data.ownerUid == request.auth.uid);
      allow delete: if false;
    }
    // Рейтинг джекпотов: каждый пишет только свою строку.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'photo', 'jackpots', 'spins', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.jackpots is number && request.resource.data.jackpots >= 0
        && request.resource.data.spins is number && request.resource.data.spins >= 0
        && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 30000));
    }
  }
}
